{
  "name": "@toa.io/origin",
  "version": "1.8.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Toa Origin",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/toa-io/origin.git"
  },
  "homepage": "https://github.com/toa-io/origin#readme",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "source",
    "README.md"
  ],
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^24.6.2",
    "eslint": "^9.27.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "neostandard": "^0.12.2",
    "semantic-release": "^24.2.9",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsup source/index.ts --dts --sourcemap --format esm,cjs --out-dir dist --clean",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "test": "npm run lint && npx tsx --test",
    "ci": "rm -rf node_modules && rm -rf package-lock.json && npm i"
  },
  "dependencies": {
    "error-value": "^0.4.4",
    "meros": "^1.3.0",
    "mitt": "^3.0.1"
  }
}
